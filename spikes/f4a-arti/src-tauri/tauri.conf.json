{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "M4TR1X F4a",
  "version": "0.1.0",
  "identifier": "org.m4tr1x.spikef4a",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "M4TR1X — prototipo F4a (Arti)", "width": 480, "height": 820 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.png"]
  }
}
